# Settings for docker-compose.yml. Copy to .env and fill in:
#   cp .env.example .env && chmod 600 .env
# Compose reads .env for ${VAR} substitution; it is also passed to the backend
# container, so any backend setting from server/app/config.py can go here.

# --- compose ---
# File compose loads into the backend container (default ./.env). Set to
# /dev/null when root can't read this file, e.g. on NFS (see docker-compose.yml).
# SVIDAT_ENV_FILE=/dev/null
# Host port the app (frontend container) is published on.
SVIDAT_PORT=8080

# --- admin bootstrap (only used if the user doesn't exist yet) ---
SVIDAT_ADMIN_USER=admin
SVIDAT_ADMIN_PASSWORD=

# --- backend ---
# Leave empty to generate one and persist it in the data volume.
SECRET_KEY=
JWT_EXPIRE_MINUTES=480
# Only needed for browsers calling the API directly, not through /api.
CORS_ORIGINS=http://localhost:8080

# --- SSO (optional) ---
# Used both at frontend build time and by the backend at runtime.
VITE_GOOGLE_CLIENT_ID=
VITE_MS_CLIENT_ID=
