# Settings for docker-compose.yml. Copy to .env and fill in:
#   cp .env.example .env && chmod 600 .env
# Compose reads .env for ${VAR} substitution; it is also passed to the backend
# container, so any backend setting from server/app/config.py can go here.

# --- compose ---
# File compose loads into the backend container (default ./.env). Set to
# /dev/null when root can't read this file, e.g. on NFS (see docker-compose.yml).
# SVIDAT_ENV_FILE=/dev/null
# Host port the app (frontend container) is published on.
SVIDAT_PORT=8080
# Interface for SVIDAT_PORT. Use 127.0.0.1 when the HTTPS proxy below (or a
# host web server) is the public entry point, so plain HTTP isn't exposed.
# SVIDAT_BIND=0.0.0.0
# URL prefix to serve the app under, e.g. /svidat/ for https://host/svidat/
# (leading and trailing slash). Paths outside it redirect into it. Rebuild
# (up -d --build) after changing.
# SVIDAT_BASE_PATH=/

# --- HTTPS proxy (optional; see "HTTPS" in README.md) ---
# proxy = nginx TLS front end, letsencrypt = certbot for its certificate.
# Drop letsencrypt when using your own cert; leave this unset to skip both.
# COMPOSE_PROFILES=proxy,letsencrypt
# SVIDAT_DOMAIN=svidat.coaps.fsu.edu
# LETSENCRYPT_EMAIL=you@example.edu
# 1 = Let's Encrypt staging (untrusted test certs, no rate limits).
# LETSENCRYPT_STAGING=0
# SVIDAT_HTTP_PORT=80
# SVIDAT_HTTPS_PORT=443
# Own certificate instead of Let's Encrypt: files in SVIDAT_CERTS_DIR
# (default ./proxy/certs), referenced by their path inside the container.
# SVIDAT_CERTS_DIR=./proxy/certs
# SVIDAT_SSL_CERT=/certs/fullchain.pem
# SVIDAT_SSL_KEY=/certs/privkey.pem

# --- admin bootstrap (only used if the user doesn't exist yet) ---
SVIDAT_ADMIN_USER=admin
SVIDAT_ADMIN_PASSWORD=

# --- backend ---
# Leave empty to generate one and persist it in the data volume.
SECRET_KEY=
JWT_EXPIRE_MINUTES=480
# Only needed for browsers calling the API directly, not through /api.
CORS_ORIGINS=http://localhost:8080

# --- SSO (optional) ---
# Used both at frontend build time and by the backend at runtime.
VITE_GOOGLE_CLIENT_ID=
VITE_MS_CLIENT_ID=
