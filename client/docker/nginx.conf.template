# Rendered by the nginx image's envsubst step: ${SVIDAT_BASE_PATH} is the URL
# prefix the app was built for ("/" or e.g. "/svidat/", set by the Dockerfile).
# nginx's own $variables are left alone (only set env vars are substituted).

# Keep the original scheme when the TLS proxy (proxy/) sits in front.
map $http_x_forwarded_proto $svidat_proto {
    default $http_x_forwarded_proto;
    ""      $scheme;
}

server {
    listen 8080;
    # Relative Location headers (e.g. /svidat -> /svidat/), so redirects
    # keep the browser on the proxy's host/scheme, not :8080.
    absolute_redirect off;
    # The build is copied to html${SVIDAT_BASE_PATH}, so $uri maps onto it.
    root /usr/share/nginx/html;

    # netCDF/avatar uploads.
    client_max_body_size 1g;

    # Same contract as vite.config.ts: strip <base>api and forward to the backend.
    location ${SVIDAT_BASE_PATH}api/ {
        proxy_pass http://backend:8000/;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $svidat_proto;
        proxy_read_timeout 300s;
    }

    # Hashed build assets never change; index.html must not be cached.
    location ${SVIDAT_BASE_PATH}assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # SPA routes (<base>plot, <base>profile, ...) fall back to index.html.
    location / {
        # Under a prefix, paths outside it (/, old /plot bookmarks) redirect
        # into it. With prefix "/" the pattern always matches: no-op.
        if ($uri !~ "^${SVIDAT_BASE_PATH}|^${SVIDAT_BASE_PATH}?$") {
            rewrite ^/(.*)$ ${SVIDAT_BASE_PATH}$1 redirect;
        }
        try_files $uri $uri/ ${SVIDAT_BASE_PATH}index.html;
        add_header Cache-Control "no-cache";
    }
}
